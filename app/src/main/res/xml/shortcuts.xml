<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press BioKey's icon: lock every app at once, without opening BioKey. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="lock_all"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_lock_all"
        android:shortcutShortLabel="@string/shortcut_lock_all_short"
        android:shortcutLongLabel="@string/shortcut_lock_all_long">
        <intent
            android:action="com.android.BioKey.action.LOCK_ALL"
            android:targetPackage="com.nbdesigns.biokey"
            android:targetClass="com.android.BioKey.feature.main.LockAllActivity" />
    </shortcut>
</shortcuts>
