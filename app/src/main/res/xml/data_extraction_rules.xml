<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred to a new device. BioKey's settings are sealed with a
    hardware key that can't leave this device, and intruder photos are encrypted with one, so a
    copy would be useless at best and a way to replay old settings at worst.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
