<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Normal permission: lets BioKey explain itself when Android's Advanced Protection blocks it. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!-- Compatibility mode (when the accessibility service can't run, e.g. under Advanced
         Protection): which app is opened (usage access), covering it (overlay), and the
         foreground service that does this while the screen is on. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />

    <!-- Package visibility: only what app locking needs, instead of QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.apps.credentialmanager" />
        <package android:name="com.android.credentialmanager" />
        <!-- Apps the user can pick to lock. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Launchers: leaving to the home screen ends an app's session. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- BioKey's own switch on the Accessibility settings page (Android 13+). -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_DETAILS_SETTINGS" />
        </intent>
        <!-- Android's own App Lock settings page (Android 17 QPR2+), linked from Settings. -->
        <intent>
            <action android:name="android.settings.APP_LOCK_SETTINGS" />
        </intent>
        <!-- Keyboards: an IME window must never count as leaving a locked app. -->
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".BioKeyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_gemini_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_gemini_icon_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.BioKey">

        <activity
            android:name=".feature.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BioKey"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.lock.LockScreenActivity"
            android:taskAffinity="com.android.BioKey.lockscreen"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.BioKey.LockScreen" />

        <service
            android:name=".feature.lock.BioKeyAccessibilityService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Only reacts to protected system broadcasts, which other apps can't send. -->
        <receiver
            android:name=".core.receiver.BioKeyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".feature.tile.BioKeyTileService"
            android:exported="true"
            android:icon="@drawable/ic_lock_key"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".feature.lock.UsageWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App lock compatibility mode: while the screen is on, reads which app was opened (usage access) to cover apps the user has locked, on devices where the accessibility service cannot run (for example under Android Advanced Protection). Nothing leaves the device." />
        </service>

        <service
            android:name=".feature.notification.BioKeyNotificationShieldService"
            android:exported="true"
            android:label="@string/notification_shield_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
