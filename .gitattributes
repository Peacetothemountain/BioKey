# Shell scripts run with sh, which breaks on Windows line endings: always LF, even in a
# checkout with core.autocrlf on.
*.sh text eol=lf
.githooks/* text eol=lf
gradlew text eol=lf
# Engine traces are read line by line, tab-separated: the same bytes on every checkout.
*.trace text eol=lf
# Generated profiles: line-for-line what the generator wrote, on every checkout.
app/src/release/generated/baselineProfiles/*.txt text eol=lf
